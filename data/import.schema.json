{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Lexicon vocabulary package v1",
  "type":"object",
  "required":["schemaVersion","deck","words"],
  "properties":{
    "schemaVersion":{"const":1},
    "deck":{"type":"object","required":["id","title","sourceLanguage","targetLanguage","version"],"properties":{"id":{"$ref":"#/$defs/text"},"title":{"$ref":"#/$defs/text"},"sourceLanguage":{"const":"ru"},"targetLanguage":{"const":"en"},"version":{"type":"integer","minimum":1}}},
    "words":{"type":"array","minItems":1,"maxItems":10000,"items":{"type":"object","required":["id","module","position","word","ipa","translations","examples","clozeItems"],"properties":{
      "id":{"$ref":"#/$defs/text"},"module":{"type":"integer","minimum":1,"maximum":1000},"position":{"type":"integer","minimum":1,"maximum":10},"word":{"$ref":"#/$defs/text"},"ipa":{"$ref":"#/$defs/text"},"translations":{"$ref":"#/$defs/answers"},"recallPrompt":{"$ref":"#/$defs/text"},"acceptedAnswers":{"$ref":"#/$defs/answers"},"collocations":{"type":"array","items":{"$ref":"#/$defs/text"}},
      "examples":{"type":"array","minItems":2,"items":{"type":"object","required":["en"],"properties":{"en":{"$ref":"#/$defs/text"},"ru":{"$ref":"#/$defs/text"}}}},
      "clozeItems":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","required":["id","en","ru","acceptedAnswers"],"properties":{"id":{"$ref":"#/$defs/text"},"en":{"type":"string","minLength":1,"maxLength":10000,"pattern":"\\{\\{gap\\}\\}"},"ru":{"$ref":"#/$defs/text"},"acceptedAnswers":{"$ref":"#/$defs/answers"}}}}
    }}}
  },
  "$defs":{"text":{"type":"string","minLength":1,"maxLength":10000,"pattern":"\\S"},"answers":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}}}
}
